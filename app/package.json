{
  "name": "hexim",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",

  "scripts": {
    "prepare": "pushd .. && husky && popd; svelte-kit sync || echo ''",
    "start": "vite dev",

    "lint:check": "prettier --check .",
    "lint": "prettier --write .",

    "test": "vitest watch",
    "test:precommit": "npm run lint:check && npm run test:unit",
    "test:ci": "npm run lint:check && npm run test:unit && npm run test:ui",
    "test:ui": "playwright install && playwright test",
    "test:unit": "vitest --run",

    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@inlang/paraglide-js": "^2.15.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/sveltekit": "^10.4.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^8.57.1",
    "eslint-plugin-svelte": "^3.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.1",
    "storybook": "^10.4.0",
    "svelte": "^5.55.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0"
  },
  "overrides": {
    "cookie": "0.7.0"
  },
  "engines": { "node": ">=24" },
  "lint-staged": { "*.{js,json,svelte,html}": "npm run lint" }
}
